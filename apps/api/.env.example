# Copia este fichero como .env y rellénalo. El .env nunca se sube.
# En Vercel, los mismos nombres en Settings → Environment Variables, sin comillas.

# Neon → Connection string con pooler, para la API.
DATABASE_URL=
# Neon → Connection string sin pooler, para aplicar migraciones (solo en local).
DATABASE_URL_DIRECTA=
# Rama de Neon de las previsualizaciones de Vercel (tarea 3.0). En Vercel, su
# DATABASE_URL va solo en Preview. Aquí, para migrarla: pnpm bd:migrar:todo.
DATABASE_URL_PREVIEW=
DATABASE_URL_PREVIEW_DIRECTA=

# Better Auth: clave aleatoria de al menos 32 caracteres, distinta en cada entorno.
BETTER_AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000 (web) o :3001 (solo API).
# En Vercel, solo en Production: https://www.inquilinus.es (la dirección principal;
# sin ella, Vercel podría elegir inquilinus.es, que solo redirige). En Preview no se
# pone: se calcula con sus variables de sistema.
BETTER_AUTH_URL=
# Registro por invitación (spec 008, R1b): emails que pueden crear cuenta, separados
# por comas. Con *, cualquiera; sin la variable o vacía, nadie. Quien ya tiene cuenta
# entra igual. En Vercel: la lista en Production y * en Preview. En local (pnpm dev), * si no se pone.
REGISTRO_INVITADOS=

# AWS (usuario IAM inquilinus-app): SES y S3. Vercel reserva los nombres AWS_*.
APP_AWS_REGION=eu-north-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# Remitente verificado en SES, solo la dirección (la app le pone el nombre «Inquilinus»).
# En Vercel (Production y Preview): no-reply@inquilinus.es; el dominio está verificado
# en SES con DKIM, MAIL FROM (correo.inquilinus.es) y DMARC.
EMAIL_REMITENTE=
# Bucket privado de S3 (Estocolmo, sin versiones). En Vercel, el de producción
# solo en Production y el de previsualizaciones en Preview; en local, el de previsualizaciones.
APP_S3_BUCKET=

# Lectura de facturas con IA (spec 003, tarea 5.1): Claude en Amazon Bedrock (bedrock-runtime)
# con las mismas credenciales de AWS. El usuario IAM necesita bedrock:InvokeModel sobre
# arn:aws:bedrock:<región>:*:inference-profile/<perfil> y
# arn:aws:bedrock:eu-*::foundation-model/<modelo base>, para cada modelo que se use.
# Sin APP_BEDROCK_MODELO no hay IA y las facturas se rellenan a mano. Solo se admite la UE:
# modelo con su identificador base (anthropic.…) o el perfil de la UE (eu.anthropic.…),
# nunca el global, y región eu-… (si falta APP_BEDROCK_REGION, se usa APP_AWS_REGION).
# En la UE, Claude Haiku 5.5 solo funciona con el perfil: eu.anthropic.claude-haiku-5-5
# Mientras AWS no lo habilite en la cuenta, en Vercel (Production y Preview) va el provisional:
# eu.anthropic.claude-haiku-4-5-20251001-v1:0
APP_BEDROCK_MODELO=
APP_BEDROCK_REGION=

# Secreto del cron de Vercel (spec 005, R8b): solo en Production. En local no hace falta.
CRON_SECRET=

# Google (tarea 2.4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
