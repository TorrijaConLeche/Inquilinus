# Copia este fichero como .env y rellénalo. El .env nunca se sube.
# En Vercel, los mismos nombres en Settings → Environment Variables, sin comillas.

# Neon → Connection string con pooler, para la API.
DATABASE_URL=
# Neon → Connection string sin pooler, para aplicar migraciones (solo en local).
DATABASE_URL_DIRECTA=
# Rama de Neon de las previsualizaciones de Vercel (tarea 3.0). En Vercel, su
# DATABASE_URL va solo en Preview. Aquí, para migrarla: pnpm bd:migrar:todo.
DATABASE_URL_PREVIEW=
DATABASE_URL_PREVIEW_DIRECTA=

# Better Auth: clave aleatoria de al menos 32 caracteres, distinta en cada entorno.
BETTER_AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000 (web) o :3001 (solo API).
# En Vercel no hace falta: se calcula con sus variables de sistema.
BETTER_AUTH_URL=

# AWS (usuario IAM inquilinus-app): SES y S3. Vercel reserva los nombres AWS_*.
APP_AWS_REGION=eu-north-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# Remitente verificado en SES.
EMAIL_REMITENTE=
# Bucket privado de S3 (Estocolmo, sin versiones). En Vercel, el de producción
# solo en Production y el de previsualizaciones en Preview; en local, el de previsualizaciones.
APP_S3_BUCKET=

# Secreto del cron de Vercel (spec 005, R8b): solo en Production. En local no hace falta.
CRON_SECRET=

# Google (tarea 2.4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
