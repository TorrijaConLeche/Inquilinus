# Copia este fichero como .env y rellénalo. El .env nunca se sube.
# En Vercel, los mismos nombres en Settings → Environment Variables, sin comillas.

# Neon → Connection string con pooler, para la API.
DATABASE_URL=
# Neon → Connection string sin pooler, para aplicar migraciones (solo en local).
DATABASE_URL_DIRECTA=

# Better Auth: clave aleatoria de al menos 32 caracteres, distinta en cada entorno.
BETTER_AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000 (web) o :3001 (solo API).
# En Vercel no hace falta: se calcula con sus variables de sistema.
BETTER_AUTH_URL=

# Amazon SES (usuario IAM inquilinus-app). Vercel reserva los nombres AWS_*.
APP_AWS_REGION=eu-north-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# Remitente verificado en SES.
EMAIL_REMITENTE=

# Google (tarea 2.4).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
